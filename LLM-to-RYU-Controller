"""
Northbound Script per LLM-Driven Network con Ryu Controller
Gestisce l'interfaccia tra LLM e il controller SDN Ryu
"""

import json
import logging
import requests
import time
from datetime import datetime
from typing import Dict, List, Optional, Tuple
from dataclasses import dataclass
from enum import Enum


# ============================================================================
# CONFIGURAZIONE LOGGING
# ============================================================================

def setup_logging():
    """Configura il sistema di logging con rotazione file"""
    logging.basicConfig(
        level=logging.INFO,
        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
        handlers=[
            logging.FileHandler('network_changes.log'),
            logging.StreamHandler()
        ]
    )
    return logging.getLogger('NorthboundScript')


logger = setup_logging()


# ============================================================================
# CLASSI DI SUPPORTO
# ============================================================================

class OperationType(Enum):
    """Tipi di operazioni supportate"""
    ADD_FLOW = "add_flow"
    DELETE_FLOW = "delete_flow"
    MODIFY_FLOW = "modify_flow"
    BLOCK_IP = "block_ip"
    ALLOW_IP = "allow_ip"
    SET_QOS = "set_qos"


@dataclass
class NetworkChange:
    """Rappresenta una modifica alla rete"""
    operation: OperationType
    parameters: Dict
    timestamp: str
    llm_input: str
    status: str = "pending"
    error_message: Optional[str] = None


class RyuAPIClient:
    """Client per comunicare con Ryu Controller via REST API"""
    
    def __init__(self, host: str = "localhost", port: int = 8080, timeout: int = 30):
        self.base_url = f"http://{host}:{port}"
        self.session = requests.Session()
        self.session.headers.update({'Content-Type': 'application/json'})
        self.timeout = timeout
        self.connection_retries = 3
        self.retry_delay = 2
        
    def _make_request(self, method: str, url: str, **kwargs) -> requests.Response:
        """Effettua richiesta con retry logic per ambienti containerizzati"""
        kwargs.setdefault('timeout', self.timeout)
        
        for attempt in range(self.connection_retries):
            try:
                response = self.session.request(method, url, **kwargs)
                return response
            except requests.exceptions.ConnectionError as e:
                if attempt < self.connection_retries - 1:
                    logger.warning(f"Tentativo {attempt + 1} fallito, retry in {self.retry_delay}s")
                    time.sleep(self.retry_delay)
                else:
                    raise e
        
        raise requests.exceptions.ConnectionError("Max retry raggiunto")
        
    def add_flow(self, dpid: str, flow: Dict) -> Tuple[bool, Optional[str]]:
        """Aggiunge un flow entry allo switch"""
        url = f"{self.base_url}/stats/flowentry/add"
        
        payload = {
            "dpid": dpid,
            "priority": flow.get("priority", 1),
            "match": flow.get("match", {}),
            "actions": flow.get("actions", [])
        }
        
        try:
            response = self._make_request('POST', url, json=payload)
            if response.status_code == 200:
                logger.info(f"Flow aggiunto con successo su switch {dpid}")
                return True, None
            else:
                error = f"Errore HTTP {response.status_code}: {response.text}"
                logger.error(error)
                return False, error
        except requests.exceptions.RequestException as e:
            error = f"Errore di connessione: {str(e)}"
            logger.error(error)
            return False, error
    
    def delete_flow(self, dpid: str, flow: Dict) -> Tuple[bool, Optional[str]]:
        """Elimina un flow entry dallo switch"""
        url = f"{self.base_url}/stats/flowentry/delete"
        
        payload = {
            "dpid": dpid,
            "priority": flow.get("priority", 1),
            "match": flow.get("match", {})
        }
        
        try:
            response = self._make_request('POST', url, json=payload)
            if response.status_code == 200:
                logger.info(f"Flow eliminato con successo su switch {dpid}")
                return True, None
            else:
                error = f"Errore HTTP {response.status_code}: {response.text}"
                logger.error(error)
                return False, error
        except requests.exceptions.RequestException as e:
            error = f"Errore di connessione: {str(e)}"
            logger.error(error)
            return False, error
    
    def get_flows(self, dpid: str) -> Optional[List[Dict]]:
        """Recupera tutti i flow entries di uno switch"""
        url = f"{self.base_url}/stats/flow/{dpid}"
        
        try:
            response = self._make_request('GET', url)
            if response.status_code == 200:
                data = response.json()
                return data.get(dpid, [])
            return None
        except requests.exceptions.RequestException as e:
            logger.error(f"Errore nel recupero flows: {str(e)}")
            return None
    
    def get_switches(self) -> Optional[List[Dict]]:
        """Recupera lista degli switch connessi"""
        url = f"{self.base_url}/stats/switches"
        
        try:
            response = self._make_request('GET', url)
            if response.status_code == 200:
                return response.json()
            return None
        except requests.exceptions.RequestException as e:
            logger.error(f"Errore nel recupero switch: {str(e)}")
            return None


# ============================================================================
# PARSER OUTPUT LLM
# ============================================================================

class LLMOutputParser:
    """Parse e valida l'output dell'LLM"""
    
    @staticmethod
    def parse(llm_output: str) -> Optional[Dict]:
        """
        Parse l'output dell'LLM e lo converte in una struttura dati
        
        Esempio input LLM:
        {
            "operation": "block_ip",
            "parameters": {
                "dpid": "1",
                "ip_address": "192.168.1.100",
                "priority": 100
            }
        }
        """
        try:
            # Rimuovi eventuali markdown code blocks
            cleaned = llm_output.strip()
            if cleaned.startswith("```"):
                lines = cleaned.split('\n')
                cleaned = '\n'.join(lines[1:-1])
            
            data = json.loads(cleaned)
            
            # Validazione base
            if "operation" not in data or "parameters" not in data:
                logger.error("Output LLM manca di 'operation' o 'parameters'")
                return None
            
            return data
            
        except json.JSONDecodeError as e:
            logger.error(f"Errore nel parsing JSON: {str(e)}")
            return None
        except Exception as e:
            logger.error(f"Errore generico nel parsing: {str(e)}")
            return None
    
    @staticmethod
    def validate(parsed_data: Dict) -> Tuple[bool, Optional[str]]:
        """Valida la struttura dei dati parsati"""
        
        operation = parsed_data.get("operation")
        parameters = parsed_data.get("parameters", {})
        
        # Verifica che l'operazione sia supportata
        try:
            OperationType(operation)
        except ValueError:
            return False, f"Operazione non supportata: {operation}"
        
        # Validazioni specifiche per operazione
        if operation in ["add_flow", "delete_flow", "modify_flow"]:
            if "dpid" not in parameters:
                return False, "Parametro 'dpid' mancante"
        
        if operation in ["block_ip", "allow_ip"]:
            if "ip_address" not in parameters:
                return False, "Parametro 'ip_address' mancante"
            if "dpid" not in parameters:
                return False, "Parametro 'dpid' mancante"
        
        return True, None


# ============================================================================
# TRADUTTORE COMANDI
# ============================================================================

class NetworkTranslator:
    """Traduce comandi high-level in configurazioni Ryu"""
    
    @staticmethod
    def block_ip(parameters: Dict) -> Dict:
        """Crea flow rule per bloccare un IP"""
        return {
            "dpid": parameters["dpid"],
            "priority": parameters.get("priority", 100),
            "match": {
                "ipv4_src": parameters["ip_address"]
            },
            "actions": []  # Nessuna azione = drop
        }
    
    @staticmethod
    def allow_ip(parameters: Dict) -> Dict:
        """Crea flow rule per permettere un IP"""
        return {
            "dpid": parameters["dpid"],
            "priority": parameters.get("priority", 50),
            "match": {
                "ipv4_src": parameters["ip_address"]
            },
            "actions": [
                {
                    "type": "OUTPUT",
                    "port": parameters.get("output_port", "NORMAL")
                }
            ]
        }
    
    @staticmethod
    def add_flow(parameters: Dict) -> Dict:
        """Passa direttamente il flow se già specificato"""
        return {
            "dpid": parameters["dpid"],
            "priority": parameters.get("priority", 1),
            "match": parameters.get("match", {}),
            "actions": parameters.get("actions", [])
        }


# ============================================================================
# VALIDATORE SICUREZZA
# ============================================================================

class SafetyValidator:
    """Valida che le modifiche siano sicure"""
    
    def __init__(self, protected_ips: List[str] = None):
        self.protected_ips = protected_ips or []
        self.max_changes_per_minute = 10
        self.change_history = []
    
    def is_safe(self, operation: OperationType, parameters: Dict) -> Tuple[bool, Optional[str]]:
        """Verifica se l'operazione è sicura"""
        
        # Rate limiting
        recent_changes = [
            c for c in self.change_history 
            if time.time() - c < 60
        ]
        if len(recent_changes) >= self.max_changes_per_minute:
            return False, "Rate limit superato: troppe modifiche al minuto"
        
        # Protezione IP critici
        if operation in [OperationType.BLOCK_IP, OperationType.DELETE_FLOW]:
            ip = parameters.get("ip_address")
            if ip in self.protected_ips:
                return False, f"IP protetto: {ip} non può essere bloccato"
        
        # Validazione priority
        priority = parameters.get("priority", 0)
        if priority > 65535:
            return False, "Priority troppo alta (max 65535)"
        
        return True, None
    
    def record_change(self):
        """Registra un cambio per rate limiting"""
        self.change_history.append(time.time())
        # Mantieni solo ultimi 100 cambi
        self.change_history = self.change_history[-100:]


# ============================================================================
# GESTORE ERRORI E ROLLBACK
# ============================================================================

class ErrorHandler:
    """Gestisce errori e rollback"""
    
    def __init__(self, ryu_client: RyuAPIClient):
        self.ryu_client = ryu_client
        self.rollback_stack = []
        self.error_count = 0
        self.max_errors = 5
    
    def save_state(self, dpid: str) -> Optional[List[Dict]]:
        """Salva lo stato corrente dei flow per rollback"""
        flows = self.ryu_client.get_flows(dpid)
        if flows:
            self.rollback_stack.append({
                "dpid": dpid,
                "flows": flows,
                "timestamp": datetime.now().isoformat()
            })
            logger.info(f"Stato salvato per switch {dpid}")
        return flows
    
    def rollback(self, dpid: str) -> bool:
        """Esegue rollback all'ultimo stato salvato"""
        if not self.rollback_stack:
            logger.warning("Nessuno stato disponibile per rollback")
            return False
        
        last_state = self.rollback_stack.pop()
        if last_state["dpid"] != dpid:
            logger.error("DPID non corrisponde allo stato salvato")
            return False
        
        logger.warning(f"Esecuzione rollback per switch {dpid}")
        
        # Elimina tutti i flow correnti
        current_flows = self.ryu_client.get_flows(dpid)
        if current_flows:
            for flow in current_flows:
                self.ryu_client.delete_flow(dpid, flow)
        
        # Ripristina i flow precedenti
        for flow in last_state["flows"]:
            self.ryu_client.add_flow(dpid, flow)
        
        logger.info("Rollback completato")
        return True
    
    def handle_error(self, error: str, change: NetworkChange):
        """Gestisce un errore"""
        self.error_count += 1
        logger.error(f"Errore ({self.error_count}/{self.max_errors}): {error}")
        
        change.status = "failed"
        change.error_message = error
        
        if self.error_count >= self.max_errors:
            logger.critical("CIRCUIT BREAKER ATTIVATO: troppi errori consecutivi")
            return False
        
        return True
    
    def reset_error_count(self):
        """Reset contatore errori dopo successo"""
        self.error_count = 0


# ============================================================================
# SCRIPT PRINCIPALE
# ============================================================================

class NorthboundScript:
    """Classe principale che orchestra tutto"""
    
    def __init__(self, ryu_host: str = "localhost", ryu_port: int = 8080):
        self.ryu_client = RyuAPIClient(ryu_host, ryu_port)
        self.parser = LLMOutputParser()
        self.translator = NetworkTranslator()
        self.safety = SafetyValidator(protected_ips=["10.0.0.1", "10.0.0.254"])
        self.error_handler = ErrorHandler(self.ryu_client)
        self.change_log = []
    
    def process_llm_output(self, llm_output: str, dry_run: bool = False) -> bool:
        """
        Processa l'output dell'LLM e applica le modifiche
        
        Args:
            llm_output: Output dall'LLM in formato JSON
            dry_run: Se True, simula senza applicare modifiche
        
        Returns:
            True se successo, False altrimenti
        """
        logger.info("="*70)
        logger.info("NUOVA RICHIESTA DA LLM")
        logger.info(f"Input: {llm_output[:200]}...")
        
        # Step 1: Parse
        parsed = self.parser.parse(llm_output)
        if not parsed:
            logger.error("Parsing fallito")
            return False
        
        # Step 2: Validazione struttura
        is_valid, error = self.parser.validate(parsed)
        if not is_valid:
            logger.error(f"Validazione fallita: {error}")
            return False
        
        operation = OperationType(parsed["operation"])
        parameters = parsed["parameters"]
        
        # Step 3: Validazione sicurezza
        is_safe, error = self.safety.is_safe(operation, parameters)
        if not is_safe:
            logger.error(f"Operazione non sicura: {error}")
            return False
        
        # Step 4: Crea oggetto NetworkChange
        change = NetworkChange(
            operation=operation,
            parameters=parameters,
            timestamp=datetime.now().isoformat(),
            llm_input=llm_output
        )
        
        if dry_run:
            logger.info("DRY RUN MODE - Nessuna modifica applicata")
            change.status = "dry_run_success"
            self.change_log.append(change)
            return True
        
        # Step 5: Salva stato per rollback
        dpid = parameters["dpid"]
        self.error_handler.save_state(dpid)
        
        # Step 6: Traduci e applica
        success = self._apply_change(operation, parameters, change)
        
        if success:
            change.status = "success"
            self.safety.record_change()
            self.error_handler.reset_error_count()
            logger.info("✓ Operazione completata con successo")
        else:
            # Rollback in caso di errore
            self.error_handler.rollback(dpid)
        
        self.change_log.append(change)
        return success
    
    def _apply_change(self, operation: OperationType, parameters: Dict, 
                     change: NetworkChange) -> bool:
        """Applica la modifica alla rete"""
        
        try:
            if operation == OperationType.BLOCK_IP:
                flow = self.translator.block_ip(parameters)
                success, error = self.ryu_client.add_flow(flow["dpid"], flow)
                
            elif operation == OperationType.ALLOW_IP:
                flow = self.translator.allow_ip(parameters)
                success, error = self.ryu_client.add_flow(flow["dpid"], flow)
                
            elif operation == OperationType.ADD_FLOW:
                flow = self.translator.add_flow(parameters)
                success, error = self.ryu_client.add_flow(flow["dpid"], flow)
                
            elif operation == OperationType.DELETE_FLOW:
                flow = self.translator.add_flow(parameters)
                success, error = self.ryu_client.delete_flow(flow["dpid"], flow)
                
            else:
                error = f"Operazione non implementata: {operation}"
                success = False
            
            if not success:
                return self.error_handler.handle_error(error, change)
            
            return True
            
        except Exception as e:
            error = f"Eccezione durante applicazione: {str(e)}"
            return self.error_handler.handle_error(error, change)
    
    def get_change_log(self) -> List[Dict]:
        """Restituisce il log di tutte le modifiche"""
        return [
            {
                "timestamp": c.timestamp,
                "operation": c.operation.value,
                "parameters": c.parameters,
                "status": c.status,
                "error": c.error_message
            }
            for c in self.change_log
        ]
    
    def export_log(self, filename: str = "changes_export.json"):
        """Esporta il log in un file JSON"""
        with open(filename, 'w') as f:
            json.dump(self.get_change_log(), f, indent=2)
        logger.info(f"Log esportato in {filename}")


