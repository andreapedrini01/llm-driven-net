# Staging Environment Configuration

# Application settings
DEBUG=false
LOG_LEVEL=INFO
JSON_LOGS=true

# API settings
API_HOST=0.0.0.0
API_PORT=8080

# Monitoring
METRICS_PORT=8000
ENABLE_METRICS=true

# ChatGPT API Configuration
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.1
OPENAI_RATE_LIMIT_RPM=60
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=3

# Network state settings
STATE_CACHE_TTL=180
STATE_REFRESH_INTERVAL=60

# Intent processing
INTENT_CONFIDENCE_THRESHOLD=0.7
MAX_CLARIFICATION_ATTEMPTS=3

# Action validation
ENABLE_ACTION_SIMULATION=true
MAX_ACTION_SEQUENCE_LENGTH=50
ACTION_TIMEOUT=300

# Anomaly detection
ANOMALY_DETECTION_ENABLED=true
ANOMALY_CHECK_INTERVAL=30
ANOMALY_THRESHOLD_MULTIPLIER=2.0

# Security
ENABLE_INPUT_SANITIZATION=true
MAX_INTENT_LENGTH=1000
RATE_LIMIT_REQUESTS_PER_MINUTE=80

# Authentication
JWT_SECRET_KEY=${JWT_SECRET_KEY}

# Default user passwords (must be changed)
ADMIN_PASSWORD=${ADMIN_PASSWORD}
OPERATOR_PASSWORD=${OPERATOR_PASSWORD}
VIEWER_PASSWORD=${VIEWER_PASSWORD}

# Notification Settings
NOTIFICATIONS_ENABLED=true
EMAIL_ENABLED=${EMAIL_ENABLED:-false}
SLACK_ENABLED=${SLACK_ENABLED:-true}
WEBHOOK_ENABLED=${WEBHOOK_ENABLED:-false}

# Email Notifications
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT:-587}
SMTP_USERNAME=${SMTP_USERNAME}
SMTP_PASSWORD=${SMTP_PASSWORD}
SMTP_FROM_EMAIL=${SMTP_FROM_EMAIL}
SMTP_TO_EMAILS=${SMTP_TO_EMAILS}
SMTP_USE_TLS=true

# Slack Notifications
SLACK_WEBHOOK_URL=${SLACK_WEBHOOK_URL}
SLACK_CHANNEL=${SLACK_CHANNEL:-#staging-alerts}
SLACK_USERNAME=LLM Module Staging

# Budget Alerts
BUDGET_ALERTS_ENABLED=true
BUDGET_DAILY_WARNING=20.0
BUDGET_DAILY_CRITICAL=40.0
BUDGET_WEEKLY_WARNING=100.0
BUDGET_WEEKLY_CRITICAL=200.0
