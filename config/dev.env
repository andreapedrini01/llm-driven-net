# Development Environment Configuration

# Application settings
DEBUG=true
LOG_LEVEL=DEBUG
JSON_LOGS=false

# API settings
API_HOST=0.0.0.0
API_PORT=8080

# Monitoring
METRICS_PORT=8000
ENABLE_METRICS=true

# ChatGPT API Configuration
OPENAI_API_KEY=your-dev-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.1
OPENAI_RATE_LIMIT_RPM=60
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=3

# Network state settings
STATE_CACHE_TTL=60
STATE_REFRESH_INTERVAL=30

# Intent processing
INTENT_CONFIDENCE_THRESHOLD=0.6
MAX_CLARIFICATION_ATTEMPTS=3

# Action validation
ENABLE_ACTION_SIMULATION=true
MAX_ACTION_SEQUENCE_LENGTH=50
ACTION_TIMEOUT=300

# Anomaly detection
ANOMALY_DETECTION_ENABLED=true
ANOMALY_CHECK_INTERVAL=30
ANOMALY_THRESHOLD_MULTIPLIER=2.0

# Security
ENABLE_INPUT_SANITIZATION=true
MAX_INTENT_LENGTH=1000
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Authentication
JWT_SECRET_KEY=dev-secret-key-not-for-production

# Default user passwords (dev only)
ADMIN_PASSWORD=admin123
OPERATOR_PASSWORD=operator123
VIEWER_PASSWORD=viewer123

# Notification Settings
NOTIFICATIONS_ENABLED=true
EMAIL_ENABLED=false
SLACK_ENABLED=false
WEBHOOK_ENABLED=false

# Budget Alerts (relaxed for dev)
BUDGET_ALERTS_ENABLED=true
BUDGET_DAILY_WARNING=50.0
BUDGET_DAILY_CRITICAL=100.0
