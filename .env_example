# LLM Integration Module Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env_example .env

# ── Application settings ──────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
JSON_LOGS=true

# ── API settings ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080

# ── Monitoring ────────────────────────────────────────────────
METRICS_PORT=8000
ENABLE_METRICS=true

# ── RYU Controller ────────────────────────────────────────────
RYU_HOST=localhost
RYU_PORT=8080
RYU_TIMEOUT=30

# ── Northbound Script ─────────────────────────────────────────
NORTHBOUND_HOST=localhost
NORTHBOUND_PORT=9090
NORTHBOUND_TIMEOUT=60

# ── OpenAI / LLM ─────────────────────────────────────────────
# Get your API key from: https://platform.openai.com/api-keys
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5.4-nano
OPENAI_MAX_TOKENS=6000
OPENAI_TEMPERATURE=0.1

# Rate limiting
OPENAI_RATE_LIMIT_RPM=60
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=3

# ── Network state ─────────────────────────────────────────────
STATE_CACHE_TTL=300
STATE_REFRESH_INTERVAL=60

# ── Intent processing ─────────────────────────────────────────
INTENT_CONFIDENCE_THRESHOLD=0.7
MAX_CLARIFICATION_ATTEMPTS=3

# ── Action validation ─────────────────────────────────────────
ENABLE_ACTION_SIMULATION=true
MAX_ACTION_SEQUENCE_LENGTH=50
ACTION_TIMEOUT=300

# ── Anomaly detection ─────────────────────────────────────────
ANOMALY_DETECTION_ENABLED=true
ANOMALY_CHECK_INTERVAL=30
ANOMALY_THRESHOLD_MULTIPLIER=2.0

# ── Network slices ────────────────────────────────────────────
MAX_SLICES_PER_TENANT=10
DEFAULT_SLICE_BANDWIDTH=100
SLICE_CREATION_TIMEOUT=120

# ── Security ──────────────────────────────────────────────────
ENABLE_INPUT_SANITIZATION=true
MAX_INTENT_LENGTH=1000
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ── Nmap / LLM summary ───────────────────────────────────────
NMAP_SERVICE_URL=http://localhost:5000
ENABLE_LLM_SUMMARY=true
